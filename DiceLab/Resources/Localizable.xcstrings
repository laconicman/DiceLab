{
  "sourceLanguage" : "en",
  "strings" : {
    "A session roll list on the table screen — tap its header to expand it toward the safe area." : {
      "comment" : "History section footer",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A session roll list on the table screen — tap its header to expand it toward the safe area."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список бросков сессии на экране стола — коснитесь заголовка, чтобы развернуть."
          }
        }
      }
    },
